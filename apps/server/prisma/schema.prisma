// SyncBoard AI+ data model.
//
// Default provider is SQLite for zero-infra local development.
// To use PostgreSQL (production), change `provider` to "postgresql" and point
// DATABASE_URL at your Postgres instance (see docker-compose.yml + .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String
  avatarColor         String    @default("#2a9d8f")
  emailVerifiedAt     DateTime?
  emailConfirmToken   String?
  emailConfirmExpires DateTime?
  createdAt           DateTime  @default(now())

  ownedProjects    Project[]         @relation("ProjectOwner")
  memberships      Membership[]
  assignedTasks    Task[]            @relation("TaskAssignee")
  activities       Activity[]
  comments         Comment[]
  syncRoomSessions SyncRoomSession[] @relation("SessionStarter")
  syncRoomEvents   SyncRoomEvent[]
  invitesSent      ProjectInvite[]   @relation("InviteSender")
  ideas            Idea[]
  ideaVotes        IdeaVote[]
  milestones       Milestone[]
  deliverableSubmissions DeliverableSubmission[]
  reviewSources          ReviewSource[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  // Manager / admin brief — collaborators should align open work to this
  requirements String  @default("")
  // visibility: "personal" | "shared"
  visibility  String   @default("shared")
  // field: industry / domain of work (general, business, mining, …)
  field       String   @default("general")
  ownerId     String
  createdAt   DateTime @default(now())

  owner            User              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members          Membership[]
  columns          Column[]
  tasks            Task[]
  activities       Activity[]
  syncRoomSessions SyncRoomSession[]
  invites          ProjectInvite[]
  milestones       Milestone[]
  ideas            Idea[]
  deliverableSubmissions DeliverableSubmission[]
  reviewSources          ReviewSource[]
}

model DeliverableSubmission {
  id              String    @id @default(cuid())
  projectId       String
  userId          String
  // status: "submitted" | "accepted" | "revision_requested"
  status          String    @default("submitted")
  memberSummary   String    @default("")
  alignmentScore  Int
  alignmentStatus String
  blockersJson    String    @default("[]")
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewerNote    String    @default("")
  reviewBrief     String    @default("")
  reviewBriefAt   DateTime?

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources ReviewSource[]

  @@unique([projectId, userId])
  @@index([projectId])
}

/** Files & links members attach for admin review (Figma exports, PDFs, design links). */
model ReviewSource {
  id           String   @id @default(cuid())
  projectId    String
  userId       String
  submissionId String?
  // kind: file | figma_link | figma_export | link
  kind         String   @default("file")
  label        String
  fileName     String   @default("")
  mimeType     String   @default("")
  fileSize     Int      @default(0)
  storageKey   String   @default("")
  externalUrl  String   @default("")
  note         String   @default("")
  createdAt    DateTime @default(now())

  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission DeliverableSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([projectId, userId])
  @@index([submissionId])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  // role: "owner" | "admin" | "member"
  role      String   @default("member")
  // Admin-assigned position + analyzer criteria for this collaborator
  positionKey          String @default("")
  positionLabel        String @default("")
  assignedRequirements String @default("")
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model ProjectInvite {
  id          String   @id @default(cuid())
  projectId   String
  email       String
  // role granted on accept: "admin" | "member"
  role        String   @default("member")
  token       String   @unique
  invitedById String
  // status: "pending" | "accepted" | "revoked"
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([email])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  // null = shared community timeline; set = that collaborator's personal timeline
  ownerId     String?
  title       String
  description String    @default("")
  // status: "upcoming" | "active" | "done"
  status      String    @default("upcoming")
  order       Int       @default(0)
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([ownerId])
}

model Idea {
  id             String   @id @default(cuid())
  projectId      String
  authorId       String
  title          String
  body           String   @default("")
  // status: "open" | "promoted" | "archived"
  status         String   @default("open")
  promotedTaskId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes   IdeaVote[]

  @@index([projectId])
}

model IdeaVote {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
}

model Column {
  id        String   @id @default(cuid())
  projectId String
  name      String
  order     Int      @default(0)
  // optional Work-In-Progress limit used by AI bottleneck detection
  wipLimit  Int?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id            String    @id @default(cuid())
  projectId     String
  columnId      String
  title         String
  description   String    @default("")
  assigneeId    String?
  // priority: "low" | "medium" | "high" | "urgent"
  priority      String    @default("medium")
  // JSON-encoded array of label strings (SQLite-compatible)
  labels        String    @default("[]")
  order         Int       @default(0)
  estimateHours Float?
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // when the task entered its current column (for stagnation detection)
  enteredColumnAt DateTime @default(now())
  completedAt   DateTime?

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column   Column  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments Comment[]
  syncRoomSessions SyncRoomSession[]

  @@index([projectId])
  @@index([columnId])
  @@index([assigneeId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  userId    String?
  // type: "task.created" | "task.moved" | "task.updated" | "task.deleted" | "member.joined" | "ai.insight"
  type      String
  message   String
  // JSON-encoded metadata (string for SQLite compatibility)
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model SyncRoomSession {
  id               String    @id @default(cuid())
  projectId        String
  contextTaskId    String?
  contextTaskTitle String?
  startedById      String
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  notes            String    @default("")
  summary          String?
  decisions        String    @default("[]")
  whiteboard       String    @default("[]")
  appliedAt        DateTime?

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedBy   User                 @relation("SessionStarter", fields: [startedById], references: [id], onDelete: Cascade)
  contextTask Task?                @relation(fields: [contextTaskId], references: [id], onDelete: SetNull)
  events      SyncRoomEvent[]
  artifacts   SyncRoomArtifact[]

  @@index([projectId])
  @@index([contextTaskId])
}

model SyncRoomEvent {
  id        String   @id @default(cuid())
  sessionId String
  kind      String
  label     String
  userId    String?
  at        DateTime @default(now())

  session SyncRoomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
}

model SyncRoomArtifact {
  id        String   @id @default(cuid())
  sessionId String
  kind      String   @default("link")
  label     String
  url       String
  createdAt DateTime @default(now())

  session SyncRoomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
