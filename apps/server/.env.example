PORT=4000
JWT_SECRET=dev-super-secret-change-me
WEB_ORIGIN=http://localhost:3000
DATABASE_URL="file:./dev.db"
# Path is relative to prisma/schema.prisma → apps/server/prisma/dev.db
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# REDIS_URL=redis://localhost:6379

# Email verification — pick ONE option below (required for new signups)

# Option A: Resend (recommended — free tier, one API key)
# Sign up at https://resend.com → API Keys → create key
# With the free tier, use onboarding@resend.dev as FROM (only delivers to your Resend account email until you verify a domain)
RESEND_API_KEY=
EMAIL_FROM="SyncBoard <onboarding@resend.dev>"

# Email verification — off until Resend domain is verified; set to true to require confirm emails
REQUIRE_EMAIL_VERIFICATION=false

# Option B: SMTP (Gmail App Password, SendGrid SMTP, Mailtrap, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="SyncBoard <you@gmail.com>"
