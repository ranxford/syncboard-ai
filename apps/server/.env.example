PORT=4000
JWT_SECRET=dev-super-secret-change-me
WEB_ORIGIN=http://localhost:3000
DATABASE_URL="file:./dev.db"
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email — use ONE provider (invites, SyncRoom alerts, AI recap)

# Local dev: Nodemailer + Gmail SMTP
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="SyncBoard <you@gmail.com>"

# Production on Render FREE: SendGrid API (HTTPS — SMTP ports are blocked)
# sendgrid.com → verify single sender → create API key
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxx
# EMAIL_FROM="SyncBoard <you@gmail.com>"

REQUIRE_EMAIL_VERIFICATION=false
