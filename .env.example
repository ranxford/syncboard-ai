# ──────────────────────────────────────────────────────────────
# SyncBoard AI+ — environment variables (reference)
#
# On first setup, `npm run setup` copies the per-app examples:
#   apps/server/.env.example  → apps/server/.env
#   apps/web/.env.local.example → apps/web/.env.local
# ──────────────────────────────────────────────────────────────

# ── Server (apps/server/.env) ───────────────────────────────
PORT=4000
JWT_SECRET=dev-super-secret-change-me
WEB_ORIGIN=http://localhost:3000
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/syncboard?schema=public"
# REDIS_URL="redis://localhost:6379"
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Web (apps/web/.env.local) ───────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# NEXT_PUBLIC_TURN_URL=turn:your-turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
